# Copy to ".env" next to this file only when a later phase needs it.
# ".env" is git-ignored; never commit it. It is read only when you pass
#   civlab run --env-file .env ...
# Phase 0 needs NONE of these values. Leave the paid API disabled.

# OpenAI API key (phase 1+ only). Never put it in config files or source code.
OPENAI_API_KEY=

# Second gate for paid API calls. Must be exactly "yes" to allow them.
# The experiment config must also set [openai] allow_paid_api = true,
# and [budget]/[pricing] must allow the calls.
CIVLAB_ALLOW_PAID_API=

# Kill switch: set to 1 to stop any run before its next model call.
CIVLAB_KILL_SWITCH=
